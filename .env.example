# .env.example: copy to .env.local. Empty = unset.

# ── Firebase (client) ──────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=#
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=#
NEXT_PUBLIC_FIREBASE_PROJECT_ID=#
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=#
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=#
NEXT_PUBLIC_FIREBASE_APP_ID=#

# ── Trustless Work / Stellar (client) ──────────────────────────
NEXT_PUBLIC_TRUSTLESS_API_URL=#
NEXT_PUBLIC_TRUSTLESS_API_KEY=#
# Trustless Work API key (booking escrow deploy/fund and the escrow indexer).
NEXT_PUBLIC_API_KEY=#
NEXT_PUBLIC_TRUSTLESS_NETWORK=testnet
# Booking escrow roles (src/features/escrow). Stellar public keys (G...).
# The booking flow refuses to start while either is missing or invalid.
NEXT_PUBLIC_PLATFORM_WALLET_ADDRESS=#
NEXT_PUBLIC_DISPUTE_RESOLVER_ADDRESS=#
# Platform fee as a percentage (5 = 5 %). Default 5.
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=5
# Booking tax as a fraction (0.1 = 10 %). 0 is valid. Default 0.1.
NEXT_PUBLIC_BOOKING_TAX_RATE=0.1
# Host payout wallet for the /room demo listing. Unset = "host has no wallet".
NEXT_PUBLIC_DEMO_HOST_WALLET_ADDRESS=#
NEXT_PUBLIC_USDC_ISSUER=#

# ── Hasura / GraphQL (client) ──────────────────────────────────
NEXT_PUBLIC_HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql

# ── WalletConnect (client) ─────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=#

# ── Development bypass for route authentication middleware ────
# Keep false or unset in production.
NEXT_PUBLIC_SKIP_AUTH_MIDDLEWARE=false
SKIP_AUTH_MIDDLEWARE=false

