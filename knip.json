{
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,global-error,route,template,default}.{js,jsx,ts,tsx}",
    "src/middleware.{js,ts}",
    "next.config.{js,ts,mjs}"
  ],
  "project": ["src/**/*.{js,jsx,ts,tsx}"],
  "ignore": ["src/components/ui/**", "src/components/tw-blocks/**"],
  "ignoreIssues": {
    ".husky/**": ["binaries"]
  },
  "ignoreDependencies": [
    "react-hook-form",
    "@axe-core/playwright",
    "@walletconnect/core",
    "@walletconnect/utils",
    "eslint-config-next",
    "eslint-config-prettier",
    "postcss-load-config",
    "react-redux"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "off",
    "types": "off",
    "duplicates": "off"
  },
  "$schema": "https://unpkg.com/knip@5/schema.json"
}
