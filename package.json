    "eslint-config-prettier": "^10.1.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "knip": "^5.46.0",
    "lint-staged": "^16.1.6",
    "postcss": "^8",
