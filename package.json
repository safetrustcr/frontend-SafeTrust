{
  "name": "frontend-safetrust",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.18 <23"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/check-thin-pages.mjs && eslint . --cache --max-warnings=0",
    "lint:fix": "eslint . --cache --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "test:e2e": "playwright test",
    "e2e:test": "npm run test:e2e --",
    "test:e2e:ui": "playwright test --ui",
    "lint-staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "size:check": "node scripts/check-bundle-budgets.js",
    "check": "npm run lint && npm run typecheck && npm run test:ci && npm run knip && npm run build && npm run size:check",
    "prepare": "husky"
  },
  "knip": {
    "entry": [
      "src/app/**/*.{ts,tsx}",
      "src/test/**/*.{ts,tsx}"
    ],
    "project": [
      "src/**/*.{ts,tsx}"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css,mjs}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^1.5.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-avatar": "^1.3.0",
    "@radix-ui/react-checkbox": "^1.4.0",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.0",
    "@radix-ui/react-select": "^2.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.0",
    "@sentry/nextjs": "^11.6.0",
    "@stellar/stellar-base": "^14.1.0",
    "@stellar/stellar-sdk": "^14.6.1",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@trustless-work/escrow": "^2.0.8",
    "@walletconnect/core": "^2.26.0",
    "@walletconnect/utils": "^2.21.9",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "i18next": "^24.2.3",
    "jose": "^5.10.0",
    "js-cookie": "^3.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "motion": "^14.1.0",
    "next": "^15.5.14",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-day-picker": "^9.6.6",
    "react-dom": "^19.3.0",
    "react-glass-ui": "^1.2.2",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^15.4.0",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "15.5.14",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.14",
    "@types/js-cookie": "^3.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.14",
    "eslint-config-prettier": "^10.1.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.2",
    "knip": "^5.46.0",
    "lint-staged": "^16.1.6",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.1",
    "typescript": "5.8.2"
  }
}
